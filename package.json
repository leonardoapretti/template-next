{
  "name": "template-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "fast-uri": "^3.1.5",
      "esbuild": "0.28.1",
      "deepmerge-ts": "^8.0.0",
