    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "deploy:vps": "bash scripts/deploy.sh"
  },
