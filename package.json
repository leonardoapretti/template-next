  "scripts": {
    "dev": "next dev --port 3000 --turbopack",
    "build": "next build --webpack",
    "build:prod": "pnpm test && pnpm audit --prod && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check . --write",
