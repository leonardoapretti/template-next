datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ActionTokenTipo {
  VERIFICACAO_EMAIL
  REDEFINICAO_SENHA
  ALTERACAO_EMAIL
  CONVITE_MEMBRO_EMPRESA
}

enum FrequenciaEvento {
  NENHUMA
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

enum StatusExcecaoEvento {
  ALTERADO
  REMARCADO
  CANCELADO
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String
  emailHash       String    @unique
  emailVerificado DateTime?
  senha           String
  imagem          String?
  isAdmin         Boolean   @default(false)
  nome            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionTokens   ActionToken[]
  membrosEmpresa MembroEmpresa[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ACCESS CONTROL / MULTI-TENANT
// ─────────────────────────────────────────────

// Tenant do template: um usuário pode estar vinculado a várias empresas
// (ver MembroEmpresa), cada uma com seus próprios papéis e permissões.
// Não há papel global do usuário — permissão sempre vem do vínculo com a
// empresa ativa (ver lib/access-control/context.ts).
model Empresa {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  // Plano de assinatura — controla o teto de features liberadas (ver
  // PlanoPermissao), independente do Role de cada membro. Opcional pra não
  // quebrar empresas já existentes: `null` é tratado como "sem restrição
  // de plano" (planoService.buscarMatriz retorna tudo liberado).
  planoId String?
  plano   Plano?  @relation(fields: [planoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros      MembroEmpresa[]
  roles        Role[]
  actionTokens ActionToken[]
  eventos      Evento[]

  @@index([planoId])
  @@map("empresas")
}

// Vínculo ativo de um usuário com uma empresa e o papel que ele tem nela.
// RN: um usuário só pode ter um vínculo por empresa (@@unique), mas pode
// estar vinculado a várias empresas simultaneamente — o "usuário admin
// compartilhado entre diversos estúdios/empresas" do pedido original.
model MembroEmpresa {
  id String @id @default(cuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, usuarioId])
  @@index([empresaId])
  @@index([usuarioId])
  @@index([roleId])
  @@map("membros_empresa")
}

// Perfil de acesso de uma empresa: concede um conjunto de permissões
// granulares por recurso e ação (ex.: "agenda:create", "empresa:configurar")
// aos membros vinculados a ela via MembroEmpresa. Usuários com
// User.isAdmin=true (superadmin da plataforma, não da empresa) ignoram
// este model (ver lib/access-control/policy.ts). padraoSistema marca os
// papéis semeados na criação da empresa (Proprietário/Administrador), que
// não podem ser renomeados/excluídos; o Proprietário, além disso, sempre
// tem todas as permissões (bypass em canUseFeature, não editável).
model Role {
  id            String  @id @default(cuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  permissoes    String[]
  padraoSistema Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros      MembroEmpresa[]
  actionTokens ActionToken[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("roles")
}

// Plano de assinatura — hoje só existe um plano ("PADRAO") liberando todas
// as chaves de lib/access-control/permission-registry.ts, mas o modelo já
// suporta múltiplos planos reais. Controla um teto de features por
// empresa, independente do Role de cada membro: uma permissão só é
// efetiva se estiver no Role do membro E liberada no plano da empresa
// (ver canUseFeature).
model Plano {
  id     String  @id @default(cuid())
  codigo String  @unique
  nome   String
  ativo  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissoes PlanoPermissao[]
  empresas   Empresa[]

  @@map("planos")
}

// Matriz de permissões do plano: uma linha por chave de
// permission-registry.ts, editável em /admin/planos. Ausência de linha
// para uma chave é tratada como permitido: false (ver
// planoService.buscarMatriz).
model PlanoPermissao {
  id String @id @default(cuid())

  planoId String
  plano   Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)

  chave     String
  permitido Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planoId, chave])
  @@index([planoId])
  @@map("planos_permissoes")
}

// ─────────────────────────────────────────────
// AGENDA
// ─────────────────────────────────────────────

// Evento de agenda de uma empresa. data/dataFim/horaInicio/horaFim ficam em
// campos de texto (não DateTime) para permitir recorrência e exceções por
// ocorrência sem depender de fuso horário — a expansão das ocorrências
// dentro de uma janela de datas acontece em app/dashboard/agenda/_components/engine.
// dataFim >= data: eventos de um dia só têm dataFim igual a data. diaTodo
// marca eventos sem horário específico (horaInicio/horaFim ficam nulos).
model Evento {
  id             String           @id @default(cuid())
  titulo         String
  data           String
  dataFim        String
  diaTodo        Boolean          @default(false)
  horaInicio     String?
  horaFim        String?
  recorrencia    FrequenciaEvento @default(NENHUMA)
  recorrenciaAte String?
  observacao     String?          @db.Text

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  excecoes EventoExcecao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([data])
  @@index([dataFim])
  @@index([recorrencia])
  @@map("eventos")
}

// Exceção a uma ocorrência específica de um evento recorrente: permite
// alterar, remarcar ou cancelar apenas aquela data sem afetar as demais.
model EventoExcecao {
  id           String              @id @default(cuid())
  eventoId     String
  evento       Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  dataOriginal String
  status       StatusExcecaoEvento

  titulo     String?
  data       String?
  dataFim    String?
  diaTodo    Boolean?
  horaInicio String?
  horaFim    String?
  observacao String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventoId, dataOriginal])
  @@index([eventoId])
  @@index([dataOriginal])
  @@map("eventos_excecoes")
}

// ─────────────────────────────────────────────
// AUTH / INFRA
// ─────────────────────────────────────────────

model ActionToken {
  id   String          @id @default(cuid())
  tipo ActionTokenTipo

  tokenHash String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String?

  // Usados por CONVITE_MEMBRO_EMPRESA: qual empresa e com qual papel o
  // convidado entra ao aceitar (ver empresaService.criarConviteEEnviar).
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([empresaId])
  @@map("action_tokens")
}

// Trilha de auditoria append-only para operações críticas (login, cadastro,
// manipulação de dados sensíveis, ações administrativas). Nenhum service deve
// expor update/delete para este model. Cada registro referencia o hash do
// registro anterior (hashAnterior), formando uma cadeia que torna qualquer
// alteração retroativa de uma linha detectável.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  usuarioId    String?
  usuarioEmail String?
  usuarioNome  String?

  acao       String
  entidade   String?
  entidadeId String?

  dadosAntes  Json?
  dadosDepois Json?

  ip        String?
  userAgent String? @db.Text

  hash         String
  hashAnterior String?

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([createdAt])
  @@map("audit_logs")
}
