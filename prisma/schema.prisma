datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ActionTokenTipo {
  VERIFICACAO_EMAIL
  REDEFINICAO_SENHA
  ALTERACAO_EMAIL
}

enum FrequenciaEvento {
  NENHUMA
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

enum StatusExcecaoEvento {
  ALTERADO
  REMARCADO
  CANCELADO
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String
  emailHash       String    @unique
  emailVerificado DateTime?
  senha           String
  imagem          String?
  isAdmin         Boolean   @default(false)
  nome            String

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionTokens ActionToken[]
  eventos      Evento[]

  @@index([roleId])
  @@map("users")
}

// ─────────────────────────────────────────────
// ACCESS CONTROL
// ─────────────────────────────────────────────

// Perfil de acesso: concede um conjunto de permissões granulares por
// recurso e ação (ex.: "usuarios:create", "usuarios:delete") aos usuários
// vinculados a ele. Usuários com isAdmin=true ignoram este model e têm
// acesso irrestrito (ver lib/access-control/policy.ts).
model Role {
  id          String   @id @default(cuid())
  nome        String   @unique
  permissoes String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios User[]

  @@map("roles")
}

// ─────────────────────────────────────────────
// AGENDA
// ─────────────────────────────────────────────

// Evento de agenda de um usuário. data/dataFim/horaInicio/horaFim ficam em
// campos de texto (não DateTime) para permitir recorrência e exceções por
// ocorrência sem depender de fuso horário — a expansão das ocorrências
// dentro de uma janela de datas acontece em app/dashboard/agenda/_components/engine.
// dataFim >= data: eventos de um dia só têm dataFim igual a data. diaTodo
// marca eventos sem horário específico (horaInicio/horaFim ficam nulos).
model Evento {
  id             String           @id @default(cuid())
  titulo         String
  data           String
  dataFim        String
  diaTodo        Boolean          @default(false)
  horaInicio     String?
  horaFim        String?
  recorrencia    FrequenciaEvento @default(NENHUMA)
  recorrenciaAte String?
  observacao     String?          @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  excecoes EventoExcecao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([data])
  @@index([dataFim])
  @@index([recorrencia])
  @@map("eventos")
}

// Exceção a uma ocorrência específica de um evento recorrente: permite
// alterar, remarcar ou cancelar apenas aquela data sem afetar as demais.
model EventoExcecao {
  id           String              @id @default(cuid())
  eventoId     String
  evento       Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  dataOriginal String
  status       StatusExcecaoEvento

  titulo     String?
  data       String?
  dataFim    String?
  diaTodo    Boolean?
  horaInicio String?
  horaFim    String?
  observacao String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventoId, dataOriginal])
  @@index([eventoId])
  @@index([dataOriginal])
  @@map("eventos_excecoes")
}

// ─────────────────────────────────────────────
// AUTH / INFRA
// ─────────────────────────────────────────────

model ActionToken {
  id   String          @id @default(cuid())
  tipo ActionTokenTipo

  tokenHash String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email String?

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("action_tokens")
}

// Trilha de auditoria append-only para operações críticas (login, cadastro,
// manipulação de dados sensíveis, ações administrativas). Nenhum service deve
// expor update/delete para este model. Cada registro referencia o hash do
// registro anterior (hashAnterior), formando uma cadeia que torna qualquer
// alteração retroativa de uma linha detectável.
model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  usuarioId    String?
  usuarioEmail String?
  usuarioNome  String?

  acao       String
  entidade   String?
  entidadeId String?

  dadosAntes  Json?
  dadosDepois Json?

  ip        String?
  userAgent String? @db.Text

  hash         String
  hashAnterior String?

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([createdAt])
  @@map("audit_logs")
}
